# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/flight-scanner

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=30d

# Skyscanner API
SKYSCANNER_API_KEY=your_skyscanner_api_key_here
SKYSCANNER_API_URL=https://api.skyscanner.com/v1

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Email
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@flightscanner.com

# Exchange Rates
EXCHANGE_RATES_API_KEY=your_exchange_rates_api_key_here

# Sentry
SENTRY_DSN=your_sentry_dsn_here

# CORS
CORS_ORIGIN=http://localhost:3000
